[sub_resource type="GDScript" id="GDScript_sh265"]
resource_name = "player.gd"
script/source = "
extends CharacterBody3D

@export var move_speed: float = 5.0
@export var mouse_sensitivity: float = 0.002

var gravity: float = 9.8
var camera_pitch: float = -0.15
var camera: Camera3D


func _ready() -> void:
	# Make a simple human-like character
	make_part(\"Body\", Vector3(0, 1.1, 0),
		Vector3(0.65, 0.85, 0.35),
		Color(0.25, 0.55, 0.35))

	make_part(\"Head\", Vector3(0, 1.85, 0),
		Vector3(0.42, 0.42, 0.42),
		Color(0.85, 0.65, 0.48))

	make_part(\"Left Arm\", Vector3(-0.48, 1.12, 0),
		Vector3(0.2, 0.7, 0.22),
		Color(0.85, 0.65, 0.48))

	make_part(\"Right Arm\", Vector3(0.48, 1.12, 0),
		Vector3(0.2, 0.7, 0.22),
		Color(0.85, 0.65, 0.48))

	make_part(\"Left Leg\", Vector3(-0.18, 0.42, 0),
		Vector3(0.23, 0.75, 0.27),
		Color(0.18, 0.2, 0.3))

	make_part(\"Right Leg\", Vector3(0.18, 0.42, 0),
		Vector3(0.23, 0.75, 0.27),
		Color(0.18, 0.2, 0.3))

	# Solid player collision
	var collision := CollisionShape3D.new()
	var shape := CapsuleShape3D.new()
	shape.radius = 0.35
	shape.height = 1.9
	collision.shape = shape
	collision.position.y = 0.95
	add_child(collision)

	# Camera behind and above the player
	var pivot := Node3D.new()
	pivot.name = \"CameraPivot\"
	pivot.position = Vector3(0, 1.5, 0)
	add_child(pivot)

	camera = Camera3D.new()
	camera.position = Vector3(0, 1.0, 5.0)
	camera.rotation_degrees.x = -12
	pivot.add_child(camera)
	camera.current = true


func make_part(part_name: String, part_position: Vector3,
	part_size: Vector3, part_color: Color) -> void:
	var part := MeshInstance3D.new()
	part.name = part_name

	var mesh := BoxMesh.new()
	mesh.size = part_size
	part.mesh = mesh
	part.position = part_position

	var material := StandardMaterial3D.new()
	material.albedo_color = part_color
	part.material_override = material

	add_child(part)


func _unhandled_input(event: InputEvent) -> void:
	if event is InputEventMouseButton and event.pressed:
		Input.mouse_mode = Input.MOUSE_MODE_CAPTURED

	if event.is_action_pressed(\"ui_cancel\"):
		Input.mouse_mode = Input.MOUSE_MODE_VISIBLE

	if event is InputEventMouseMotion:
		if Input.mouse_mode == Input.MOUSE_MODE_CAPTURED:
			rotate_y(-event.relative.x * mouse_sensitivity)


func _physics_process(delta: float) -> void:
	if not is_on_floor():
		velocity.y -= gravity * delta
	else:
		if velocity.y < 0:
			velocity.y = 0

	var input_dir := Input.get_vector(
		\"ui_left\", \"ui_right\", \"ui_up\", \"ui_down\"
	)

	var direction := (
		transform.basis * Vector3(input_dir.x, 0, input_dir.y)
	).normalized()

	if direction.length() > 0:
		velocity.x = direction.x * move_speed
		velocity.z = direction.z * move_speed
	else:
		velocity.x = move_toward(velocity.x, 0, move_speed)
		velocity.z = move_toward(velocity.z, 0, move_speed)

	move_and_slide()
"

